# Webkorps Command Center - local environment configuration
#
# Copy this file to `.env` and fill in real values. `.env` is gitignored and
# must never be committed. This file only documents the *shape* of the
# configuration; it contains no real secrets.
#
#   cp .env.example .env
#
# Then, before running any `superset` command, load it and point Superset at
# our config module:
#
#   set -a; source .env; set +a
#
# (the provided `scripts/dev_env.sh` does this for you - see DEVELOPMENT_SETUP.md)

# --- Core Flask/Superset ---

# Generate with: openssl rand -base64 42
# Never reuse this across environments, and never commit a real value.
SUPERSET_SECRET_KEY=changeme-generate-your-own-with-openssl-rand-base64-42

# development | production
SUPERSET_ENV=development
FLASK_DEBUG=true
FLASK_APP="superset.app:create_app()"

# Points Superset at superset_config.py in this repo (do not remove).
SUPERSET_CONFIG_PATH=./superset_config.py

# Where Superset stores its local state (logs, uploaded files, sqlite
# fallback, etc). Keep this out of the repo (already gitignored).
SUPERSET_HOME=./.superset_home

# --- PostgreSQL (metadata database) ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_DB=wkcc_superset
DATABASE_USER=wkcc_app
DATABASE_PASSWORD=changeme-local-postgres-password

# --- Redis (Celery broker/results + caching) ---
# NOTE: this host's Redis is shared with other local projects. We use a
# dedicated logical DB index per purpose so we never collide with db0.
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_CELERY_BROKER_DB=1
REDIS_CELERY_RESULTS_DB=2
REDIS_CACHE_DB=3

# --- Frontend dev server ---
SUPERSET_WEBSERVER_PORT=8088
FRONTEND_DEV_SERVER_PORT=9000

# --- Admin bootstrap (used only by scripts/init_db.sh, not read by Superset itself) ---
SUPERSET_ADMIN_USERNAME=admin
SUPERSET_ADMIN_FIRSTNAME=Admin
SUPERSET_ADMIN_LASTNAME=User
SUPERSET_ADMIN_EMAIL=admin@example.com
SUPERSET_ADMIN_PASSWORD=changeme-local-admin-password
